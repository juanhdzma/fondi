# Clave del panel admin. El default de la app es "admin" — cambialo antes de exponer
# el servicio fuera de la LAN.
ADMIN_PASSWORD=cambiame

# Orígenes permitidos por CORS, separados por coma. Vacío = solo mismo origen, que es el
# caso de producción (front y back en el mismo container). Solo hace falta para `npm run dev`.
ALLOWED_ORIGINS=

# Horas entre backups automáticos de la DB (0 desactiva). Quedan al lado del archivo,
# dentro del volumen: no reemplazan sacar el xlsx a otra máquina.
BACKUP_INTERVAL_H=24

# Nivel de log del backend: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Poné 1 SOLO si hay un reverse proxy adelante (Traefik, nginx). Sin esto el límite de
# intentos de clave cuenta por IP del proxy y un intento fallido bloquea a todos; con esto
# se lee X-Forwarded-For. No lo prendas con el puerto expuesto directo: ahí ese header lo
# pone el cliente y cualquiera se saltaría el límite mandando uno distinto cada vez.
TRUST_PROXY=
