# Admin panel password. The app defaults to "admin": change it before exposing the
# service outside your LAN.
ADMIN_PASSWORD=change-me

# Comma-separated CORS origins. Empty = same origin only, which is the production case
# (frontend and backend in the same container). Only needed for `npm run dev`.
ALLOWED_ORIGINS=

# Hours between automatic DB backups (0 disables them). They live next to the file,
# inside the volume: they don't replace copying the xlsx to another machine.
BACKUP_INTERVAL_H=24

# Backend log level: DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO

# Set to 1 ONLY behind a reverse proxy (Traefik, nginx). Without it the failed-login
# limit counts the proxy's IP and one failure locks everyone out; with it the app reads
# X-Forwarded-For. Leave it off when the port is exposed directly: there the client sets
# that header and anyone could bypass the limit by sending a different one each time.
TRUST_PROXY=

# Set to 0 when the frontend is hosted separately and FastAPI shouldn't mount its files.
SERVE_STATIC=1

# API URL baked into the frontend build when it is hosted separately.
VITE_API_BASE_URL=
